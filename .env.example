# PostgreSQL connection string used for LangGraph checkpointing
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Default language provider (Groq)
GROQ_API_KEY=
# Tavily key for the hotel search agent
TAVILY_API_KEY=
# AviationStack key for the flight search agent
AVIATIONSTACK_API_KEY=
# Fallback origin IATA code when a request only mentions a destination (Toronto, Canada)
DEFAULT_ORIGIN=YYZ
