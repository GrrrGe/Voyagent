# Production uses OpenAI for itinerary and report generation.
# Local development can set LLM_PROVIDER=mock to run without keys.
FLIGHT_PROVIDER=mock
HOTEL_PROVIDER=mock
LLM_PROVIDER=openai
# Set individual provider flags to live only when the matching key is present.
AVIATIONSTACK_API_KEY=
TAVILY_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Leave blank for durable local SQLite. Set for Postgres checkpoints.
DATABASE_URL=
# Production requires a stable random secret of at least 32 characters.
SESSION_SECRET=
APP_ENV=development
# DATA_DIR=.data
# Public HTTPS origin behind a reverse proxy. Render supplies RENDER_EXTERNAL_URL.
# PUBLIC_ORIGIN=https://your-domain.example
# OpenAI powers the itinerary ordering and trip report. Server-side only.
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_MODEL=gpt-4.1-mini
# Embedding model for the Chroma knowledge index. Uses offline hash embeddings when no key is set.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
