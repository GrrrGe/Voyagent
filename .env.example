# PostgreSQL connection string used for LangGraph checkpointing
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Default language provider (OpenAI). Set the key below to enable it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional fallback: Groq is used only when OPENAI_API_KEY is unset.
GROQ_API_KEY=
# Tavily key for the hotel search agent
TAVILY_API_KEY=
# AviationStack key for the flight search agent
AVIATIONSTACK_API_KEY=
# Fallback origin IATA code when a request only mentions a destination
DEFAULT_ORIGIN=DEL
